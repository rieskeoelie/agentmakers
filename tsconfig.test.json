{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/lib/outreach/**/*.ts",
    "src/components/admin/**/*.tsx",
    "test/outreach/**/*.ts",
    "test/outreach/**/*.tsx",
    "test/security/**/*.ts",
    "vitest.config.mts",
    "src/components/admin/**/*.ts",
    "test/admin/**/*.ts",
    "test/admin/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
